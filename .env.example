# ==============================================================================
# SERVIQ-X Backend — Environment Variables
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# Groq — Primary LLM Provider
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ==============================================================================
# Supabase — Database, Auth & Storage
# ==============================================================================
SUPABASE_URL=https://pphphvjhwfudeunipcqm.supabase.co
SUPABASE_ANON_KEY=sb_publishable_ANC-YmcjrtcsfwBaaRTJ-w_feaQslah
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

# ==============================================================================
# Embeddings — PDF Knowledge Base (768-dim)
# ==============================================================================
GOOGLE_API_KEY=your_google_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004

# ==============================================================================
# LangSmith — AI Observability & Evaluation
# ==============================================================================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=SERVIQ-X
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
