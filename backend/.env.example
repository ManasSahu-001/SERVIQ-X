# ==============================================================================
# SERVIQ-X — Backend Environment Configuration Template
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000

# Supabase (PostgreSQL, Auth, pgvector, Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key

# Groq LLM API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LangSmith Observability & Tracing
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=SERVIQ-X

# Embeddings Configuration (Supports: 'mock', 'openai', 'local')
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=sk-your-openai-or-embedding-key-if-used
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Frontend & CORS URLs
FRONTEND_URL=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# Demo / Local development token bypass (allows testing without live Supabase cloud keys)
DEMO_AUTH_ENABLED=true
